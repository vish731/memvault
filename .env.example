# Get one at https://geomi.dev (Network: Testnet, Client usage: OFF)
SHELBY_API_KEY=aptoslabs_xxxxxxxxxxxxxxxxxxxxxxxx

# A funded Aptos testnet account's private key (this app's single "service account").
# Generate one with the Shelby CLI (`shelby init`) or Aptos CLI, then fund it via:
#   https://docs.shelby.xyz/apis/faucet/aptos
#   https://docs.shelby.xyz/apis/faucet/shelbyusd
SHELBY_PRIVATE_KEY=ed25519-priv-0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres connection string (Neon / Vercel Postgres integration)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
